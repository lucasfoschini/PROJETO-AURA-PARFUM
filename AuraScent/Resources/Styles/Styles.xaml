<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <OnPlatform x:Key="EditorialFont" x:TypeArguments="x:String" Default="OpenSansSemibold">
        <On Platform="WinUI" Value="Georgia" />
        <On Platform="Android" Value="serif" />
        <On Platform="iOS, MacCatalyst" Value="Georgia" />
    </OnPlatform>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource EditorialFont}" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="36" />
    </Style>
    <Style x:Key="Title" TargetType="Label" BasedOn="{StaticResource Headline}">
        <Setter Property="FontSize" Value="25" />
    </Style>
    <Style x:Key="CardTitle" TargetType="Label" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="19" />
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="Glass" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassColor}" />
        <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Glass}">
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="GhostEntry" TargetType="Entry">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassColor}" />
        <Setter Property="BorderColor" Value="{StaticResource GlassStroke}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
                            <Setter Property="BorderWidth" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters><Setter Property="Opacity" Value="0.8" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters><Setter Property="Opacity" Value="0.55" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderColor" Value="{StaticResource AccentForeground}" />
        <Setter Property="TextColor" Value="{StaticResource AccentForeground}" />
    </Style>
</ResourceDictionary>
