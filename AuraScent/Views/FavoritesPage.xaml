<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="AuraScent.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AuraScent.ViewModels"
    xmlns:ctl="clr-namespace:AuraScent.Controls"
    xmlns:m="clr-namespace:AuraScent.Models"
    x:DataType="vm:FavoritesViewModel" Shell.NavBarIsVisible="False"
    SafeAreaEdges="All" Background="{DynamicResource AtmosphereBackdrop}">

    <Grid x:Name="PageContent" RowDefinitions="Auto,*" MaximumWidthRequest="1200" Padding="16,12,16,0" RowSpacing="16">
        <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
            <ctl:MenuButton VerticalOptions="Start" />
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="Sua coleção" Style="{StaticResource Eyebrow}" />
                <Label Text="Favoritos" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="FavoritesLayout" Orientation="Vertical" Span="1" VerticalItemSpacing="10" HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Style="{StaticResource Glass}" Padding="18" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sua coleção está vazia" Style="{StaticResource Title}" />
                        <Label Text="Salve os perfumes de que você gosta para encontrá-los aqui." Style="{StaticResource Body}" />
                        <Button Text="Explorar perfumes" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start"
                                Command="{Binding ShowExploreCommand}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:PerfumeSummary">
                    <ctl:PerfumeCard IsList="True"
                                     OpenCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=OpenPerfumeCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer><BoxView HeightRequest="18" Color="Transparent" /></CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
