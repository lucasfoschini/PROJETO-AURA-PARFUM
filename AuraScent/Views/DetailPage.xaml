<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AuraScent.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AuraScent.ViewModels"
    xmlns:ctl="clr-namespace:AuraScent.Controls"
    xmlns:m="clr-namespace:AuraScent.Models"
    x:DataType="vm:DetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Ink}">

    <Grid>
        <ctl:AuroraBackground Atmosphere="{Binding State.Current}" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,56,24,40" Spacing="24">

                <Button Text="‹  Voltar" Command="{Binding BackCommand}" Style="{StaticResource PillButton}"
                        HeightRequest="42" FontSize="13" Padding="20,0" HorizontalOptions="Start" />

                <VerticalStackLayout x:Name="HeroBlock" Opacity="0" Spacing="6">
                    <ctl:BottleView Perfume="{Binding Summary}" AnimateLiquid="True" HeightRequest="240" />

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Image Source="{Binding CountryFlagUrl}" HeightRequest="18" WidthRequest="27"
                               Aspect="AspectFit" IsVisible="{Binding CountryFlagUrl, Converter={StaticResource StringToBoolConverter}}" />
                        <Label Text="{Binding Summary.House}" Style="{StaticResource Eyebrow}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Summary.Name}" Style="{StaticResource Headline}" FontSize="40" />

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border Style="{StaticResource Chip}" HorizontalOptions="Start"
                                IsVisible="{Binding Summary.DisplayFamily, Converter={StaticResource StringToBoolConverter}}">
                            <Label Text="{Binding Summary.DisplayFamily}" TextColor="White" FontSize="13" />
                        </Border>
                        <Border Style="{StaticResource Chip}" HorizontalOptions="Start"
                                IsVisible="{Binding EnrichedConcentration, Converter={StaticResource StringToBoolConverter}}">
                            <Label Text="{Binding EnrichedConcentration}" TextColor="White" FontSize="13" />
                        </Border>
                        <Border Style="{StaticResource Chip}" HorizontalOptions="Start"
                                IsVisible="{Binding EnrichedGender, Converter={StaticResource StringToBoolConverter}}">
                            <Label Text="{Binding EnrichedGender}" TextColor="White" FontSize="13" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Lede}" Style="{StaticResource Body}" Margin="0,12,0,0"
                           IsVisible="{Binding Lede, Converter={StaticResource StringToBoolConverter}}" />

                    <Label Text="{Binding TranslatedLede}" Style="{StaticResource Body}"
                           TextColor="{StaticResource Accent}" FontAttributes="Italic"
                           IsVisible="{Binding TranslatedLede, Converter={StaticResource StringToBoolConverter}}" />

                    <Label Text="{Binding EnrichedCharacter}" Style="{StaticResource Body}"
                           Margin="0,4,0,0"
                           IsVisible="{Binding EnrichedCharacter, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HorizontalOptions="Start" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#FF9A9A" />

                <VerticalStackLayout x:Name="LayersBlock" Opacity="0" Spacing="14"
                                     BindableLayout.ItemsSource="{Binding Layers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteLayerDisplay">
                            <Border Style="{StaticResource Glass}" Padding="20">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="{Binding Name}" Style="{StaticResource Eyebrow}" />
                                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                                                BindableLayout.ItemsSource="{Binding Notes}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NoteItemViewModel">
                                                <Border Style="{StaticResource Chip}" Padding="14,10" Margin="0,0,8,8" MinimumHeightRequest="44">
                                                    <Label Text="{Binding Name}" TextColor="White" FontSize="14" VerticalOptions="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasEnrichedData}">

                    <Border Style="{StaticResource Glass}" Padding="20"
                            IsVisible="{Binding AccordsText, Converter={StaticResource StringToBoolConverter}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Acordes" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AccordsText}" Style="{StaticResource Title}" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Glass}" Padding="20"
                            IsVisible="{Binding PerfumersText, Converter={StaticResource StringToBoolConverter}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Perfumista(s)" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding PerfumersText}" Style="{StaticResource Title}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Glass}" Padding="12,18"
                                IsVisible="{Binding LongevityText, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center"><Label Text="Longevidade" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" /><Label Text="{Binding LongevityText}" FontSize="26" CharacterSpacing="2" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Glass}" Padding="12,18"
                                IsVisible="{Binding ProjectionText, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center"><Label Text="Projeção" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" /><Label Text="{Binding ProjectionText}" FontSize="26" CharacterSpacing="2" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" /></VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Glass}" Padding="20"
                            IsVisible="{Binding SeasonsText, Converter={StaticResource StringToBoolConverter}}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Estações ideais" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding SeasonsText}" Style="{StaticResource Title}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsEnriching}" IsVisible="{Binding IsEnriching}"
                                   Color="{StaticResource Accent}" HorizontalOptions="Start"
                                   HeightRequest="24" WidthRequest="24" />

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="{Binding FavoriteLabel}"
                                Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Grid.Column="1" Text="Ver no Scento" Command="{Binding OpenScentoCommand}" Style="{StaticResource PillButton}" />
                    </Grid>
                    <Button Text="Ver na 10ML" Command="{Binding OpenTenMlCommand}" Style="{StaticResource PillButton}"
                            IsVisible="{Binding TenMlUrl, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
