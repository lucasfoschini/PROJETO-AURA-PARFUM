<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="AuraScent.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:AuraScent.Controls"
    Shell.NavBarIsVisible="False" SafeAreaEdges="All" Background="{DynamicResource AtmosphereBackdrop}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" MaximumWidthRequest="800" Spacing="16">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
                <ctl:MenuButton VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Sobre o app" Style="{StaticResource Eyebrow}" />
                    <Label Text="Aura Parfum" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Glass}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Perfumes que sentem o clima" Style="{StaticResource Title}" />
                    <Label Text="Escolha uma cidade. O clima atual define a atmosfera do dia e guia as recomendações de perfumes."
                           Style="{StaticResource Body}" />
                    <Label Text="Explore por nota, casa ou fragrância e salve seus perfumes em Favoritos."
                           Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Fontes de dados" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Glass}" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Open-Meteo" Style="{StaticResource CardTitle}" />
                    <Label Text="Busca de cidades e condições meteorológicas atuais." Style="{StaticResource Body}" />
                    <Label Text="Scento Perfume" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <Label Text="Catálogo, casas e pirâmide olfativa." Style="{StaticResource Body}" />
                    <Label Text="10ML Fragrance Index" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <Label Text="Acordes, perfumistas, estações, longevidade e projeção, quando disponíveis." Style="{StaticResource Body}" />
                    <Label Text="MyMemory" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <Label Text="Traduções de descrições e notas para português." Style="{StaticResource Body}" />
                    <Label Text="FlagCDN" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <Label Text="Imagens das bandeiras dos países." Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Privacidade" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Glass}" Padding="20">
                <Label Text="A cidade é usada nas consultas de clima ao Open-Meteo. Favoritos e preferências ficam no dispositivo."
                       Style="{StaticResource Body}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
