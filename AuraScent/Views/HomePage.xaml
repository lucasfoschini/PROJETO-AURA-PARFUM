<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AuraScent.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AuraScent.ViewModels"
    xmlns:ctl="clr-namespace:AuraScent.Controls"
    xmlns:m="clr-namespace:AuraScent.Models"
    x:DataType="vm:HomeViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Ink}">

    <Grid>
        <ctl:AuroraBackground Atmosphere="{Binding State.Current}" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,56,24,40" Spacing="26">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="agora em" Style="{StaticResource Eyebrow}" />
                        <Entry Text="{Binding City}" Style="{StaticResource GhostEntry}"
                               Placeholder="Digite uma cidade" ReturnType="Search"
                               ReturnCommand="{Binding LoadCommand}" />
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowCitySuggestions}"
                                             BindableLayout.ItemsSource="{Binding CitySuggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:CitySuggestion">
                                    <Border Style="{StaticResource Glass}" Padding="12,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectCityCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="White" />
                                            <Label Text="{Binding SecondaryText}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <ctl:MenuButton Grid.Column="1" VerticalOptions="Start" />
                </Grid>

                <VerticalStackLayout x:Name="HeroBlock" Opacity="0" Spacing="2">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding TemperatureText}" Style="{StaticResource Display}" />
                        <Image Source="{Binding CountryFlagUrl}" HeightRequest="28" WidthRequest="42"
                               Aspect="AspectFit" VerticalOptions="Center"
                               IsVisible="{Binding CountryFlagUrl, Converter={StaticResource StringToBoolConverter}}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding WeatherSummary}" Style="{StaticResource Title}" />
                    <Label Text="{Binding State.Current.Tagline}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}" HorizontalOptions="Start" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#FF9A9A" />

                <VerticalStackLayout x:Name="CardsBlock" Opacity="0" Spacing="14">
                    <Label Text="{Binding State.Current.Name, StringFormat='Assinaturas para um dia {0}'}"
                           Style="{StaticResource Eyebrow}" />

                    <CollectionView ItemsSource="{Binding Recommendations}" ItemsLayout="HorizontalList"
                                    HeightRequest="312" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:PerfumeSummary">
                                <ctl:PerfumeCard WidthRequest="222" HeightRequest="296" Margin="0,0,14,0">
                                    <ctl:PerfumeCard.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenPerfumeCommand}"
                                            CommandParameter="{Binding .}" />
                                    </ctl:PerfumeCard.GestureRecognizers>
                                </ctl:PerfumeCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
