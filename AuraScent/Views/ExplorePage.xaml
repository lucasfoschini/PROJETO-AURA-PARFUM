<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AuraScent.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AuraScent.ViewModels"
    xmlns:ctl="clr-namespace:AuraScent.Controls"
    xmlns:m="clr-namespace:AuraScent.Models"
    x:DataType="vm:ExploreViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Ink}">

    <Grid>
        <ctl:AuroraBackground Atmosphere="{Binding State.Current}" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,56,24,40" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="explorar" Style="{StaticResource Eyebrow}" />
                        <Label Text="Encontre sua assinatura" Style="{StaticResource Headline}" />
                    </VerticalStackLayout>
                    <ctl:MenuButton Grid.Column="1" VerticalOptions="Start" />
                </Grid>

                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource Glass}" Padding="18,4">
                        <Entry Text="{Binding Query}" Style="{StaticResource GhostEntry}"
                               Placeholder="Nota, casa ou perfume…" ReturnType="Search"
                               ReturnCommand="{Binding SearchCommand}" />
                    </Border>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowSuggestions}"
                                         BindableLayout.ItemsSource="{Binding Suggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:PerfumeSuggestion">
                                <Border Style="{StaticResource Glass}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectSuggestionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="{Binding Category}" TextColor="{StaticResource Accent}"
                                               FontSize="11" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" TextColor="White" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding QuickTerms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource Chip}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SearchCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}" TextColor="White" FontSize="14" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HorizontalOptions="Start" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#FF9A9A" />
                </VerticalStackLayout>

                <Label Text="Busque por uma nota (oud, rosa, baunilha…), uma casa ou o nome de um perfume."
                       Style="{StaticResource Body}" Margin="0,6,0,0"
                       IsVisible="{Binding HasNoResults}" />

                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding Results}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:PerfumeSummary">
                            <ctl:PerfumeCard HeightRequest="190" FlexLayout.Basis="48.5%" Margin="0,0,0,12">
                                <ctl:PerfumeCard.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=OpenPerfumeCommand}"
                                        CommandParameter="{Binding .}" />
                                </ctl:PerfumeCard.GestureRecognizers>
                            </ctl:PerfumeCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
