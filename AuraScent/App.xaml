<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="AuraScent.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:AuraScent.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Conversores de valor -->
            <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
            <conv:IntToBoolConverter x:Key="IntToBoolConverter" />

            <!-- Paleta base (o clima muda o resto em tempo real) -->
            <Color x:Key="Ink">#07070D</Color>
            <Color x:Key="GlassColor">#14FFFFFF</Color>
            <Color x:Key="GlassStroke">#2EFFFFFF</Color>
            <Color x:Key="TextMuted">#B8B5C8</Color>
            <Color x:Key="Accent">#E8D5A8</Color>

            <!-- Tipografia -->
            <Style x:Key="Display" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="92" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="Headline" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="Title" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="1.35" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>
            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="4" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>

            <!-- Vidro (glassmorphism) -->
            <Style x:Key="Glass" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource GlassColor}" />
                <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="28" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource GlassColor}" />
                <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="#80FFFFFF" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#26FFFFFF" />
                <Setter Property="BorderColor" Value="#44FFFFFF" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="#44FFFFFF" />
                <Setter Property="TextColor" Value="#07070D" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
