<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="AuraScent.Controls.PerfumeCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:AuraScent.Models"
             x:DataType="m:PerfumeSummary">
    <Border Style="{StaticResource Glass}">
        <Grid RowDefinitions="*,Auto" Padding="18">
            <Label Text="{Binding Initial}"
                   FontFamily="OpenSansSemibold" FontSize="150" TextColor="White" Opacity="0.10"
                   HorizontalOptions="End" VerticalOptions="Start" Margin="0,-18,-4,0" />
            <VerticalStackLayout Grid.Row="1" Spacing="4">
                <Label Text="{Binding House}" Style="{StaticResource Eyebrow}" MaxLines="1" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" />
                <Label Text="{Binding DisplayFamily}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
