<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="AuraScent.AppShell" x:Name="ShellRoot"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AuraScent.Views"
       xmlns:local="clr-namespace:AuraScent"
       Shell.FlyoutBehavior="Flyout" Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource Ink}"
       Shell.TabBarBackgroundColor="{StaticResource Surface}"
       Shell.TabBarForegroundColor="{DynamicResource Accent}"
       Shell.TabBarTitleColor="{DynamicResource Accent}"
       Shell.TabBarUnselectedColor="{StaticResource TextMuted}"
       FlyoutBackgroundColor="{StaticResource Ink}" FlyoutWidth="276">

    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource Ink}">
            <Grid BackgroundColor="{DynamicResource AtmosphereTop}" Padding="24,24,18,22"
                  ColumnDefinitions="*,48" ColumnSpacing="8">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="AURA" CharacterSpacing="7" Style="{StaticResource Headline}" />
                    <Label Text="PARFUM" Style="{StaticResource Eyebrow}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="×" FontSize="24" Padding="0" Style="{StaticResource PillButton}"
                        VerticalOptions="Start" SemanticProperties.Description="Fechar menu" Clicked="CloseFlyout" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10" Padding="14,12">
                    <VerticalStackLayout Spacing="5"
                        BindableLayout.ItemsSource="{Binding Source={x:Reference ShellRoot}, Path=Destinations, x:DataType=local:AppShell}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FlyoutDestination">
                                <Grid>
                                    <Button Style="{StaticResource PillButton}" CommandParameter="{Binding Location}" Clicked="OpenFromFlyout"
                                            BackgroundColor="Transparent" BorderColor="Transparent" CornerRadius="14"
                                            SemanticProperties.Description="{Binding Title}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MatchingText}">
                                                        <Binding Path="Route" />
                                                        <Binding Source="{x:Reference ShellRoot}" Path="ActiveDestination" x:DataType="local:AppShell" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentGlass}" />
                                                <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
                                                <Setter Property="SemanticProperties.Hint" Value="Destino atual" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="12" Padding="14,0" InputTransparent="True"
                                          AutomationProperties.ExcludedWithChildren="True">
                                        <Image Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" />
                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Alterar cidade" ImageSource="aura_search.png" ContentLayout="Left,10" Clicked="FindCity"
                            Style="{StaticResource PillButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </ScrollView>

            <Label Grid.Row="2" Text="Perfumes que sentem o clima." Style="{StaticResource Caption}" Padding="24,16,20,24" />
        </Grid>
    </Shell.FlyoutContent>

    <FlyoutItem Route="discover" Title="Descobrir" FlyoutDisplayOptions="AsMultipleItems">
        <Tab Route="todayTab" Title="Hoje" Icon="aura_home.png">
            <ShellContent Route="home" Title="Hoje" Icon="aura_home.png" ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Route="exploreTab" Title="Explorar" Icon="aura_explore.png">
            <ShellContent Route="explore" Title="Explorar" Icon="aura_explore.png" ContentTemplate="{DataTemplate views:ExplorePage}" />
        </Tab>
        <Tab Route="favoritesTab" Title="Favoritos" Icon="aura_heart.png">
            <ShellContent Route="favorites" Title="Favoritos" Icon="aura_heart.png" ContentTemplate="{DataTemplate views:FavoritesPage}" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem Route="information" Title="Sobre o app" Icon="aura_about.png">
        <Tab Route="aboutTab">
            <ShellContent Route="about" ContentTemplate="{DataTemplate views:AboutPage}" />
        </Tab>
    </FlyoutItem>
</Shell>
